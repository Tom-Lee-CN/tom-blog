    "@vuepress/bundler-vite": "^2.0.0-rc.31",
    "@vuepress/plugin-shiki": "^2.0.0-rc.132",
    "sass-embedded": "^1.102.0",
    "vue": "^3.4.0",
    "vuepress": "^2.0.0-rc.31"
  }
}
